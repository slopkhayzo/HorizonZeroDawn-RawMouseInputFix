#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HZDRM_VERSION_MAJOR, HZDRM_VERSION_MINOR, HZDRM_VERSION_PATCH, 0
 PRODUCTVERSION HZDRM_VERSION_MAJOR, HZDRM_VERSION_MINOR, HZDRM_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "HZDRawMouse - raw mouse camera for Horizon Zero Dawn (ASI plugin)"
            VALUE "FileVersion", HZDRM_VERSION_STRING
            VALUE "InternalName", "HZDRawMouse"
            VALUE "OriginalFilename", "HZDRawMouse.asi"
            VALUE "ProductName", "HZDRawMouse"
            VALUE "ProductVersion", HZDRM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
